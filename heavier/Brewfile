# =============================================================================
# Brewfile — Full Research + Dev Workstation (heavier)
# =============================================================================
# Philosophy: Full TeX, build toolchain, Docker, QGIS.
#             Geospatial stacks (GDAL, etc.) managed in conda envs, not system-wide.
#
# Install everything:
#   brew bundle --file heavier/Brewfile
#
# Check state without installing:
#   brew bundle check --no-upgrade --file heavier/Brewfile
#
# Dump current installed state back into this file:
#   brew bundle dump --file heavier/Brewfile --force
# =============================================================================

# -----------------------------------------------------------------------------
# Phase 1 prerequisites (installed before brew bundle, listed here for record)
# -----------------------------------------------------------------------------
# xcode-select  — installed via: xcode-select --install
# brew          — installed via the official install script

# -----------------------------------------------------------------------------
# Core CLI tools
# -----------------------------------------------------------------------------
brew "git"          # Modern git (supersedes Xcode CLT version on PATH)
brew "gh"           # GitHub CLI — PRs, issues, auth from terminal
brew "aria2"        # Multi-connection download accelerator
brew "wget"         # HTTP/FTP downloader
brew "curl"         # HTTP client (keep alongside macOS system curl)
brew "jq"           # JSON processor
brew "tree"         # Directory tree listing
brew "htop"         # Interactive process monitor
brew "ripgrep"      # Fast recursive grep (rg)
brew "fd"           # Fast find alternative
brew "fzf"          # Fuzzy finder for shell history, files, git
brew "zoxide"       # Smart cd — learns frequent directories
brew "rsync"        # File sync to/from HPC and NAS
brew "tmux"         # Terminal multiplexer — persistent HPC sessions
brew "mosh"         # Resilient SSH over unstable connections (VPN, travel)

# -----------------------------------------------------------------------------
# Build toolchain
# (Absent from Brewfile_light)
# -----------------------------------------------------------------------------
brew "gcc"          # GNU compiler collection (C/C++/Fortran)
brew "cmake"        # Cross-platform build system generator
brew "pkg-config"   # Helper for compiling applications and libraries
brew "make"         # Build automation tool

# -----------------------------------------------------------------------------
# Scientific Python / R tooling
# -----------------------------------------------------------------------------
cask "miniconda"    # Minimal conda; ARM-native; use conda-forge channel
brew "uv"           # Fast Python package/project manager (Rust-based)
brew "r"            # R language runtime

# -----------------------------------------------------------------------------
# Node.js: dashboards, web previews, AI agent CLIs
# -----------------------------------------------------------------------------
brew "fnm"          # Fast Node version manager (replaces nvm)
brew "pnpm"         # Fast, disk-efficient npm alternative

# -----------------------------------------------------------------------------
# Writing and publishing
# -----------------------------------------------------------------------------
cask "quarto"         # Scientific publishing (Markdown → PDF/HTML/slides)
cask "mactex"         # Full MacTeX (~4 GB); all packages available via tlmgr
                      # Use `brew install --cask basictex` for a lightweight alternative
cask "zotero"         # Reference manager (install browser connectors separately)
cask "obsidian"       # Long-form research notes and knowledge base
cask "microsoft-office"  # Sign in with institutional/personal Microsoft account

# -----------------------------------------------------------------------------
# Browsers (frequently updated — managed via Homebrew)
# -----------------------------------------------------------------------------
cask "firefox"
cask "google-chrome"

# -----------------------------------------------------------------------------
# Remote access
# -----------------------------------------------------------------------------
cask "windows-app"  # Microsoft remote desktop (requires macOS 14+;
                    # do NOT install alongside microsoft-remote-desktop)

# -----------------------------------------------------------------------------
# Containerisation
# -----------------------------------------------------------------------------
cask "docker"       # Docker Desktop — includes daemon, CLI, Compose, and GUI
                    # After install: open Docker.app once to complete setup

# -----------------------------------------------------------------------------
# Geospatial — QGIS
# -----------------------------------------------------------------------------
#
# IMPORTANT — Two install methods, different Python behaviour:
#
#   cask "qgis"  (used here — official DMG build)
#     • Installs QGIS.app with its own bundled Python interpreter:
#         /Applications/QGIS.app/Contents/MacOS/bin/python3
#     • Conda / pip packages installed outside QGIS are NOT visible to plugins.
#     • To install a package for use inside QGIS plugins:
#         sudo /Applications/QGIS.app/Contents/MacOS/bin/pip3 install <package>
#       Packages land in the .app bundle's own site-packages.
#     • To reset all pip-installed packages: brew reinstall --cask qgis
#       (replaces the entire .app bundle — clean slate).
#     • Pro: fast install, no compilation, always matches the official release.
#
#   brew install qgis  (formula — NOT used here)
#     • Compiles QGIS from source against Homebrew's Python (~45 min build).
#     • Packages installed with `pip install` in that Python are visible to plugins.
#     • Pro: tighter conda/pip integration.
#     • Con: long compile time; can break after brew upgrades.
#
#   For most plugin use cases the cask is the right choice. If you need full
#   conda/pip visibility in plugins, switch to the formula.
#
# GDAL note: do NOT install gdal/proj/geos system-wide via Homebrew.
#   Use a dedicated conda environment instead:
#     conda create -n geo python=3.12
#     conda install -c conda-forge gdal geopandas rasterio
#   This avoids conflicts with QGIS's own bundled GDAL.
#
cask "qgis"         # QGIS Desktop (official DMG); see Python + GDAL notes above

